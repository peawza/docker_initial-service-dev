# # -------------------------
# # Load Test Parameters
# # -------------------------
# PERF_QUEUE_NAME=perf.test.durable

# # ---------- Publisher (เบา ๆ) ----------
# PERF_PRODUCERS=60            # จำลอง 40 เครื่องก่อน
# PERF_SIZE=122880             # ~120 KB ต่อ message
# PERF_RATE=10                 # รวม ~10 msg/s (≈ 1.2 MB/s)
# PERF_TOTAL_MESSAGES=4000     # รวม 4,000 msg (~480 MB data ผ่าน broker)

# # ---------- Consumer ----------
# PERF_CONSUMERS=1             # 2 ตัวช่วยกันอ่าน
# PERF_CONSUME_EXPECTED=4000   # เท่ากับ TOTAL_MESSAGES
# PERF_PREFETCH=10              # 5 x 120KB ≈ 600KB/in-flight ต่อ consumer
# PERF_ACK=1                   # manual ack


PERF_QUEUE_NAME=perf.test.20x10kb

# ---------- Publisher (20 เครื่อง, 10 KB, ส่งทุก 5 วิ) ----------
PERF_PRODUCERS=20           # 20 เครื่องจริง
PERF_SIZE=10240             # ~10 KB (10 * 1024)
PERF_RATE=4                 # รวม ~4 msg/s  (20 เครื่อง × 1 msg/5 วิ)
PERF_TOTAL_MESSAGES=2400    # รวม 2,400 msg  (เท่ากับยิงประมาณ 10 นาที)

# ---------- Consumer ----------
PERF_CONSUMERS=1            # 1 consumer ตามที่กำหนด
PERF_CONSUME_EXPECTED=2400  # ให้เท่ากับ TOTAL_MESSAGES
PERF_PREFETCH=10            # 10 x 10KB = ~100KB in-flight เบามาก
PERF_ACK=1                  # manual ack เหมือน production