#!/usr/bin/env bash
set -e

# =========================
# K3s install (Debian) - CLI แบบสั้น อ่านง่าย
# =========================

apt-get update
apt-get install -y curl sudo

# -----------------------------------------
# ติดตั้ง k3s (คำสั่งเดียวจบ) ✅
# -----------------------------------------
curl -sfL https://get.k3s.io | sh -

# -----------------------------------------
# เช็คสถานะบริการ k3s
# -----------------------------------------
systemctl status k3s --no-pager || true
k3s kubectl get nodes -o wide

# -----------------------------------------
# ถ้าเครื่อง RAM ต่ำ (< 2GB) แนะนำแบบเบาลง
# (ปิด traefik เพื่อลด memory)
#
# *** ใช้อย่างใดอย่างหนึ่ง ***
# - ถ้าคุณใช้คำสั่งด้านบนไปแล้ว และอยากเปลี่ยนเป็น low-ram:
#   ให้ uninstall ก่อน แล้วค่อยติดตั้งใหม่ (ดูด้านล่าง)
# -----------------------------------------
# curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="--disable traefik" sh -

# -----------------------------------------
# ทำให้ใช้ kubectl ปกติได้
# -----------------------------------------
mkdir -p ~/.kube
cp /etc/rancher/k3s/k3s.yaml ~/.kube/config
export KUBECONFIG=~/.kube/config

# แล้วลอง:
kubectl get nodes -o wide

# -----------------------------------------
# (ทางเลือก) ถ้าต้องการ uninstall k3s
# -----------------------------------------
# /usr/local/bin/k3s-uninstall.sh
