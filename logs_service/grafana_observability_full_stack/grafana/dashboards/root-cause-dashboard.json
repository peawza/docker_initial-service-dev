{
  "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"}]},
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Rate (RPS)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(app_http_requests_total[1m]))", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Error Rate (5xx)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(app_http_requests_total{status=~\"5..\"}[1m]))", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "p95 Latency (s)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(app_http_request_duration_seconds_bucket[5m])))", "refId": "A"}]
    },
    {
      "type": "logs",
      "title": "Application Logs",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{job=\"debug-api\"}", "refId": "A", "queryType": "range"}],
      "options": {"showTime": true, "showLabels": true, "sortOrder": "Descending"}
    },
    {
      "type": "timeseries",
      "title": "Container CPU (debug-api)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(container_cpu_usage_seconds_total{name=~\".*debug-api.*\"}[1m]))", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Container Memory (debug-api)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(container_memory_working_set_bytes{name=~\".*debug-api.*\"})", "refId": "A"}]
    }
  ],
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["observability", "root-cause", "logs", "metrics", "traces"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
  "title": "Root Cause Analysis - Full Observability",
  "uid": "root-cause-full-observability",
  "version": 1
}
